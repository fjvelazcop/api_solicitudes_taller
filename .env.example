# Configuración del Servidor Express
PORT=4000
FRONTEND_PORT=4100
NODE_ENV=development
APP_URL="http://localhost:4000"

# Ciberseguridad y Autenticación JWT
JWT_SECRET=development-secret-keys-for-sanluis-app-2026
JWT_PREAUTH_SECRET=development-preauth-secret-keys-for-sanluis-app-2026
SESSION_TTL=8h
PREAUTH_TTL=15m
CORS_ORIGIN=http://localhost:4100
TENANT_HEADER=X-Tenant-ID

# Configuración de Base de Datos Principal (SQLite para desarrollo local sin Docker)
DB_DIALECT=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sanluis_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_STORAGE=./data/sanluis.sqlite
DB_SYNC=true

# Conexión Adicional MSSQL - Servidor Profit Plus (AD_TRANS)
PROFIT_DB_HOST=SRVBDPROFITBK
PROFIT_DB_PORT=1433
PROFIT_DB_NAME=AD_TRANS
PROFIT_DB_USER=fvelazco
PROFIT_DB_PASSWORD=Inicio123
PROFIT_DB_DIALECT=mssql

# Almacenamiento Multimedia (Local / Cloud S3)
UPLOAD_DIR=./data/uploads
STORAGE_DRIVER=local
CLOUD_STORAGE_BUCKET=sanluis-multimedia-prod
CLOUD_STORAGE_REGION=us-east-1

# Notificaciones (Email & Web Push)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=desarrollo.corpoagro@gmail.com
SMTP_PASS=
SMTP_FROM="Grupo San Luis - Notificaciones <notificaciones@empresasanluis.com>"

# IA Multiagente (Gemini AI API)
GEMINI_API_KEY=""
